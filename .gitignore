# ════════════════════════════════════════════════════════════════════
.next/
out/
dist/
build/
**/dist/
**/lib/

# SDK built artifacts (rebuilt with `npm run build`)
backend/sdk-spark/public/v1/popup.js
backend/sdk-spark/public/v1/popup.css
backend/blaze/sdk/public/v1/popup.js
backend/blaze/sdk/public/v1/popup.css

# TypeScript incremental cache
*.tsbuildinfo
tsconfig.tsbuildinfo

# ════════════════════════════════════════════════════════════════════
